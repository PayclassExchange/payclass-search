# Copy these into Coolify's environment settings. Do not commit real values.

# Required
SEARCH_MANAGER_API_KEY=

# Resources (each resource loads only when its value is set)
SEARXNG_URL=
COURTLISTENER_TOKEN=
SEC_USER_AGENT=
FRED_API_KEY=

# Plain-language intake through LiteLLM (optional)
LITELLM_URL=
LITELLM_API_KEY=
INTAKE_MODEL=

# Shared Redis for cache (optional; memory cache if unset)
REDIS_URL=

# Tuning (defaults shown in the README)
DEFAULT_DEADLINE_SECONDS=
MAX_DEADLINE_SECONDS=
RESOURCE_CONCURRENCY=
CACHE_TTL_SECONDS=
BREAKER_THRESHOLD=
BREAKER_COOLDOWN_SECONDS=
